  "document_semantics": {
    "document_role":"面向电力行业主管部门、标准化技术委员会及电力企业的标准体系研究报告",
    "subject_of_report":"电力领域数据基础设施标准体系",
    "primary_thesis":"依托国家制度部署与中电联先行先试任务，电力行业需要以统一框架衔接既有标准和企业实践，形成七类标准体系、分级研制重点与三阶段实施路径。",
    "author_purpose":"为标准立项、研制、实施和先行先试标准验证提供系统性参考。",
    "argument_method":["AN-01","AN-02","AN-03","AN-04","AN-05","AN-06","AN-07","AN-08"],
    "supporting_basis":["国家数据基础设施建设部署","能源行业数据分类分级制度","中电联先行先试任务书","电力行业现有标准与企业实践","GB/T 13016标准体系表方法"],
    "business_objects":["标准体系框架","重点标准","先行先试场景","实施与保障机制"],
    "decision_boundary":"研究提出体系框架、研制建议和实施路径，不代表相关标准已完成立项、发布或全面实施。",
    "scope":"覆盖电力数据全生命周期和发输变配用调专业链条，衔接国家数据基础设施四大方向、八大能力与行业任务。",
    "decision_intent":"支持后续标准立项排序、场景验证安排和协同推进。"
  },
  "document_thesis": {"statement":"电力数据基础设施标准化已具备国家政策、行业实践和先行先试任务基础，应以七类标准体系为骨架，按急用先行原则分三级研制，并与项目建设和场景验证同步推进。","source_refs":["SU-B56DFFEECD-PARAGRAPH-7C71112F4466-01","SU-B56DFFEECD-PARAGRAPH-E272B23C7BE3-01","SU-B56DFFEECD-PARAGRAPH-331D290FE21D-01","SU-B56DFFEECD-PARAGRAPH-22F54C1161C7-01","SU-B56DFFEECD-PARAGRAPH-02689104A034-01"],"argument_weight":"core"},
