      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0260",
      "fact_type": "statement",
      "text": "四是战略生态合作。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
