        "line_end": 340
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0244",
      "fact_type": "statement",
      "text": "提供专家服务、研究分析、评价认证、规则方法、咨询实施和行业经验，承担专业交付和质量保障责任。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "一、合作伙伴类型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0147",
