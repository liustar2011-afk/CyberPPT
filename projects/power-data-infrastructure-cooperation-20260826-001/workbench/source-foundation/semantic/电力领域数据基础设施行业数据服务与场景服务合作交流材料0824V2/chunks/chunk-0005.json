      "source_ref": {
        "block_id": "blk-0152",
        "line_start": 352,
        "line_end": 352
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0257",
      "fact_type": "statement",
      "text": "三是场景联合运营合作。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0153",
