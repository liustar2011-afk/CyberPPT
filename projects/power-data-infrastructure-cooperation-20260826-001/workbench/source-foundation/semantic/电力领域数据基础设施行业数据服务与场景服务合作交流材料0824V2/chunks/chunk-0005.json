        "line_end": 340
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0245",
      "fact_type": "statement",
      "text": "五是技术实施合作伙伴。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "一、合作伙伴类型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0148",
        "line_start": 342,
        "line_end": 342
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0246",
      "fact_type": "statement",
      "text": "提供可信连接、数据治理、隐私保护计算、安全审计、系统集成、算力资源、模型开发和运维保障等能力。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "一、合作伙伴类型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0148",
        "line_start": 342,
        "line_end": 342
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0247",
      "fact_type": "statement",
      "text": "六是市场与生态合作伙伴。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "一、合作伙伴类型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0149",
        "line_start": 344,
        "line_end": 344
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0248",
      "fact_type": "statement",
      "text": "提供客户渠道、项目机会、生态组织、联合推广和市场协同，参与需求发现、客户拓展和成果复制。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "一、合作伙伴类型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0149",
        "line_start": 344,
        "line_end": 344
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0249",
      "fact_type": "statement",
      "text": "平台根据合作伙伴资源成熟度、参与深度和业务目标，形成从资源接入、产品共建、场景共营到战略协同的四类合作模式。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0150",
        "line_start": 348,
        "line_end": 348
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0250",
      "fact_type": "statement",
      "text": "不同模式可以独立采用，也可以随着合作成熟度逐步深化。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0150",
        "line_start": 348,
        "line_end": 348
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0251",
      "fact_type": "statement",
      "text": "一是标准接入合作。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0151",
        "line_start": 350,
        "line_end": 350
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0252",
      "fact_type": "statement",
      "text": "适用于已经形成明确产品、接口或者服务能力，权利边界清晰、质量稳定、能够持续提供服务的合作伙伴。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0151",
        "line_start": 350,
        "line_end": 350
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0253",
      "fact_type": "statement",
      "text": "重点完成产品说明、权利和技术测试、服务上架及客户试用。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0151",
        "line_start": 350,
        "line_end": 350
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0254",
      "fact_type": "statement",
      "text": "二是联合产品合作。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0152",
        "line_start": 352,
        "line_end": 352
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0255",
      "fact_type": "statement",
      "text": "适用于拥有优质资源或者专业能力，仍需开展产品化封装、市场定位和服务设计的合作伙伴。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0152",
        "line_start": 352,
        "line_end": 352
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0256",
      "fact_type": "statement",
      "text": "各方共同开展需求分析、产品策划、治理加工、计量定价、样例验证和市场推广。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
