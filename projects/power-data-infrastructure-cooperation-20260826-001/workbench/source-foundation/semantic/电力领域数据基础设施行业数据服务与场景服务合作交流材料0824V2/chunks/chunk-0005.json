      "segment_index": 2
    },
    {
      "fact_id": "fact-0243",
      "fact_type": "statement",
      "text": "四是专业服务合作伙伴。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "一、合作伙伴类型"
      ],
      "claim_status": "source_assertion",
