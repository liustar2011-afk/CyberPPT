        "line_end": 354
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0258",
      "fact_type": "statement",
      "text": "适用于客户业务问题复杂、需要多方能力组合和持续服务的场景。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "二、合作模式"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
