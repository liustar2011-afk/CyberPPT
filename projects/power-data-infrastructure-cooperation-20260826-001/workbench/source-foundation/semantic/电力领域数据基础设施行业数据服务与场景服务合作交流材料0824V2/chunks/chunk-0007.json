      "source_ref": {
        "block_id": "blk-0220",
        "line_start": 516,
        "line_end": 516
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0384",
      "fact_type": "statement",
      "text": "十是场景专项信息。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0221",
        "line_start": 518,
        "line_end": 518
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0385",
      "fact_type": "statement",
      "text": "场景服务还应明确业务目标，标准型、配置型或者定制型分类，联合主体，职责分工，实施里程碑，数据和模型需求，交付成果，试运行，验收指标，运营期安排，标准化范围和复制推广条件。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0221",
        "line_start": 518,
        "line_end": 518
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0386",
      "fact_type": "statement",
      "text": "十一是客户与市场信息。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
