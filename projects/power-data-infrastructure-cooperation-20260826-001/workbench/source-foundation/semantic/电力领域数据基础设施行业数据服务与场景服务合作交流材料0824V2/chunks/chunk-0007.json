        "line_end": 554
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0416",
      "fact_type": "statement",
      "text": "明确使用的数据、知识、模型、算法、系统、算力和专家资源，说明来源、版本、权限、更新和使用限制。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0237",
        "line_start": 554,
        "line_end": 554
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0417",
      "fact_type": "statement",
      "text": "三是技术实施内容。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0238",
        "line_start": 556,
        "line_end": 556
      },
