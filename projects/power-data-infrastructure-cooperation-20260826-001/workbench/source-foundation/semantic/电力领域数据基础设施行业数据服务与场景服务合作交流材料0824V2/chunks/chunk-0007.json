        "line_end": 498
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0365",
      "fact_type": "statement",
      "text": "一是基本信息。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0212",
        "line_start": 500,
        "line_end": 500
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0366",
      "fact_type": "statement",
      "text": "包括产品或者场景名称、唯一编码、服务类型、提供单位、运营单位、责任人、目标客户、应用领域、主要内容、核心价值和当前成熟度。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
