    },
    {
      "fact_id": "fact-0364",
      "fact_type": "statement",
      "text": "数据产品、数据服务和场景服务原则上形成规范说明，作为产品立项、合作洽谈、平台准入、技术实施、商务报价、客户订购、授权执行、计量结算和服务评价的共同依据。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
