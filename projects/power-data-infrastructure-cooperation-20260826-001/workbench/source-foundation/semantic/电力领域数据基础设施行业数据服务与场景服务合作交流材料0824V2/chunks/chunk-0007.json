        "line_end": 516
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0383",
      "fact_type": "statement",
      "text": "包括分类分级、访问控制、加密脱敏、隐私保护、输出控制、审计方式、保密责任、变更管理、续约、产品暂停下架、数据删除和合作终止安排。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
