        "line_end": 500
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0367",
      "fact_type": "statement",
      "text": "二是资源和权利信息。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0213",
        "line_start": 502,
        "line_end": 502
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0368",
      "fact_type": "statement",
      "text": "包括数据、知识、模型和算法来源，权利依据，内容范围，数据级别，允许用途，禁止用途，授权期限，客户范围，衍生成果归属和二次使用条件。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0213",
        "line_start": 502,
        "line_end": 502
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0369",
      "fact_type": "statement",
      "text": "三是服务规格信息。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
