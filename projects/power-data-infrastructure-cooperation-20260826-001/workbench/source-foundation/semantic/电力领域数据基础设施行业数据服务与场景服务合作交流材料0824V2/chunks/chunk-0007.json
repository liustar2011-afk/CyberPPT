        "line_end": 504
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0371",
      "fact_type": "statement",
      "text": "四是访问与成果交付信息。",
      "heading_path": [
        "附件二　产品及场景服务说明要点"
      ],
