  "facts": [
    {
      "fact_id": "fact-0301",
      "fact_type": "statement",
      "text": "合作终止时，各方按照约定完成存量订单履行、客户通知、授权撤销、数据返还或者删除、模型和接口停用、账单结算和资料归档。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "五、数据安全、权利与衍生成果保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0173",
        "line_start": 400,
        "line_end": 400
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0302",
      "fact_type": "statement",
      "text": "平台和合作伙伴建立常态质量保障、运行监测、分级响应和变更控制机制，覆盖数据质量、服务可用性、模型效果、场景成效、商务履约和安全合规，确保客户服务统一受理、内部责任落实到方。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0174",
        "line_start": 404,
        "line_end": 404
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0303",
      "fact_type": "statement",
      "text": "一是建立质量标准和责任分工。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0175",
        "line_start": 406,
        "line_end": 406
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0304",
      "fact_type": "statement",
      "text": "数据服务重点关注准确性、完整性、一致性、及时性和可追溯性；",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0175",
        "line_start": 406,
        "line_end": 406
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0305",
      "fact_type": "statement",
      "text": "模型服务重点关注适用性、稳定性、可解释性、安全性和结果边界；",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0175",
        "line_start": 406,
        "line_end": 406
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0306",
      "fact_type": "statement",
      "text": "场景服务重点关注业务目标、交付成果、持续运行、客户应用成效和复制条件。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0175",
        "line_start": 406,
        "line_end": 406
      },
      "segment_index": 4
    },
    {
      "fact_id": "fact-0307",
      "fact_type": "statement",
      "text": "二是加强模型和版本治理。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0176",
        "line_start": 408,
        "line_end": 408
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0308",
      "fact_type": "statement",
      "text": "涉及人工智能的服务实行模型登记、版本管理、构建数据来源说明、模型评测、输入输出检查、调用日志、版本回退和停用管理；",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0176",
        "line_start": 408,
        "line_end": 408
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0309",
      "fact_type": "statement",
      "text": "对高风险预测、诊断和决策辅助结果，明确适用条件、人工复核要求和责任边界。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0176",
        "line_start": 408,
        "line_end": 408
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0310",
      "fact_type": "statement",
      "text": "三是开展运行监测和异常响应。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0177",
        "line_start": 410,
        "line_end": 410
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0311",
      "fact_type": "statement",
      "text": "持续监测数据质量、接口运行、模型输出、服务可用性、客户反馈、安全事件和商务履约，根据影响程度开展客户沟通、恢复处理、专项复核、服务暂停、安全处置和整改闭环。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0177",
        "line_start": 410,
        "line_end": 410
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0312",
      "fact_type": "statement",
      "text": "四是落实变更和退出管理。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0178",
        "line_start": 412,
        "line_end": 412
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0313",
      "fact_type": "statement",
      "text": "产品内容、数据来源、模型版本、授权范围、交付方式、价格规则和服务等级发生重大变化时，履行变更确认、版本更新和客户通知；",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0178",
        "line_start": 412,
        "line_end": 412
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0314",
      "fact_type": "statement",
      "text": "对持续质量不达标、权利条件不清、存在重大安全合规风险或者严重违反合作约定的事项，按照协议和平台规则采取整改、限制调用、暂停服务、产品下架或者终止合作等措施。",
      "heading_path": [
        "第四章　合作模式与保障机制",
        "六、服务质量与风险保障"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0178",
        "line_start": 412,
        "line_end": 412
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0315",
      "fact_type": "statement",
      "text": "具体合作事项根据需求真实性、资源成熟度、权利条件、技术可行性、商务可行性和持续运营能力分阶段推进，原则上形成“合作意向—资源与需求对接—成熟度评估—方案深化—试点验证—正式运营与复制推广”的推进路径。",
      "heading_path": [
        "第五章　合作对接与推进安排"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0179",
        "line_start": 416,
        "line_end": 416
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0316",
      "fact_type": "statement",
      "text": "中电联负责重大合作事项统筹和行业资源协调。",
      "heading_path": [
        "第五章　合作对接与推进安排",
        "一、合作意向登记"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0180",
        "line_start": 420,
        "line_end": 420
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0317",
      "fact_type": "statement",
      "text": "中电联数智公司作为平台运营单位，建立合作伙伴常态化对接机制和统一窗口，围绕数据资源、专业知识、模型算法、技术能力、业务场景和市场需求开展合作交流、需求征集、资源对接和事项跟踪。",
      "heading_path": [
        "第五章　合作对接与推进安排",
