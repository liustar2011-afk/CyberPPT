        "line_end": 472
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0345",
      "fact_type": "statement",
      "text": "中电联将充分发挥行业组织、专业资源、会员生态和平台运营优势，持续完善电力数据要素流通利用、数据产品开发和行业服务运营体系，推动数据资源和专业能力更好服务国家战略、行业发展和企业需求。",
      "heading_path": [
        "结束语"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0200",
        "line_start": 472,
        "line_end": 472
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0346",
      "fact_type": "statement",
      "text": "诚邀电力企业、能源企业、科研院所、高等院校、数字科技企业、数据服务机构、技术服务机构及相关生态伙伴参与平台合作，将优质数据、知识、模型、技术和场景能力接入电力领域数据基础设施，共同开发可持续运营的数据服务产品，共同建设可复制推广的高价值应用场景，共同培育开放协同、安全可信、互利共赢的行业服务生态，推动电力数据要素价值充分释放。",
      "heading_path": [
        "结束语"
      ],
