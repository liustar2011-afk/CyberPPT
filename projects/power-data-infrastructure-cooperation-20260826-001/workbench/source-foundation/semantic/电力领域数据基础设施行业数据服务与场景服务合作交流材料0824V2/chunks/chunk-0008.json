  "facts": [
    {
      "fact_id": "fact-0421",
      "fact_type": "statement",
      "text": "五是客户使用安排。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0240",
        "line_start": 560,
        "line_end": 560
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0422",
      "fact_type": "statement",
      "text": "明确试点用户、使用频次、调用额度、操作培训、客户支持、意见反馈和成果确认方式。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0240",
        "line_start": 560,
        "line_end": 560
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0423",
      "fact_type": "statement",
      "text": "六是业务验收指标。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0241",
        "line_start": 562,
        "line_end": 562
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0424",
      "fact_type": "statement",
      "text": "根据场景明确效率提升、准确性改善、风险识别、成本降低、管理优化、科研教学效果或者其他可验证成果。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0241",
        "line_start": 562,
        "line_end": 562
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0425",
      "fact_type": "statement",
      "text": "七是技术和服务指标。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0242",
        "line_start": 564,
        "line_end": 564
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0426",
      "fact_type": "statement",
      "text": "明确服务可用性、响应时效、接口成功率、数据质量、模型性能、版本稳定性和故障恢复要求。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0242",
        "line_start": 564,
        "line_end": 564
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0427",
      "fact_type": "statement",
      "text": "八是计量和成本验证。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0243",
        "line_start": 566,
        "line_end": 566
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0428",
      "fact_type": "statement",
      "text": "记录调用、任务、数据量、算力、人员工时和成果交付，验证有效计量规则，分析客户报价、直接成本、平台运营收入、合作伙伴结算、毛利水平、价格接受度和现金流安排。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0243",
        "line_start": 566,
        "line_end": 566
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0429",
      "fact_type": "statement",
      "text": "九是试点评估材料。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0244",
        "line_start": 568,
        "line_end": 568
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0430",
      "fact_type": "statement",
      "text": "形成客户使用和验收记录、服务计量记录、质量与服务等级记录、安全合规检查结果、成本价格分析和问题整改清单。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0244",
        "line_start": 568,
        "line_end": 568
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0431",
      "fact_type": "statement",
      "text": "十是转运营决策。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0245",
        "line_start": 570,
        "line_end": 570
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0432",
      "fact_type": "statement",
      "text": "明确转入正式运营、优化后再次验证、暂停投入或者终止的结论，并说明正式运营所需产品版本、价格、合同、服务保障和推广安排。",
      "heading_path": [
        "附件四　试点实施与验收要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0245",
        "line_start": 570,
        "line_end": 570
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0433",
      "fact_type": "statement",
      "text": "产品和场景在正式运营前应当统一明确计量对象、有效事件、客户确认、结算基础、分配方法和结算阶段，确保客户账单与合作伙伴结算依据一致。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0246",
        "line_start": 574,
        "line_end": 574
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0434",
      "fact_type": "statement",
      "text": "一是计量对象。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0247",
        "line_start": 576,
        "line_end": 576
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0435",
      "fact_type": "statement",
      "text": "明确客户、产品、版本、订单、合同、授权、服务权益和交付结果之间的关联关系，保证每项计量对应具体业务依据。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0247",
        "line_start": 576,
        "line_end": 576
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0436",
      "fact_type": "statement",
      "text": "二是有效计量事件。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0248",
        "line_start": 578,
        "line_end": 578
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0437",
      "fact_type": "statement",
      "text": "明确接口成功调用、有效返回记录、数据集交付、模型任务完成、报告交付、监测周期完成或者场景里程碑完成的判定条件。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0248",
        "line_start": 578,
        "line_end": 578
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0438",
      "fact_type": "statement",
      "text": "三是异常计量处理。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0249",
        "line_start": 580,
        "line_end": 580
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0439",
      "fact_type": "statement",
      "text": "明确调用失败、超时、重复请求、系统重试、部分交付、客户取消、测试调用和人工补录的认定和处理规则。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0249",
        "line_start": 580,
        "line_end": 580
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0440",
      "fact_type": "statement",
      "text": "四是试用和套餐规则。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0250",
        "line_start": 582,
        "line_end": 582
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0441",
      "fact_type": "statement",
      "text": "明确免费额度、试用期限、套餐包含量、超额调用、折扣条件、优惠承担主体和试用转正式服务的处理方式。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0250",
        "line_start": 582,
        "line_end": 582
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0442",
      "fact_type": "statement",
      "text": "五是账单生成与客户确认。",
      "heading_path": [
        "附件五　服务计量、账单与结算要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0251",
