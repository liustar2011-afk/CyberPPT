  "facts": [
    {
      "fact_id": "fact-0061",
      "fact_type": "statement",
      "text": "二是建设行业数据与专业能力运营平台。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "二、总体定位"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0052",
        "line_start": 116,
        "line_end": 116
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0062",
      "fact_type": "statement",
      "text": "统一组织数据资源、知识资源、模型算法、专业能力和技术能力，衔接资源登记、产品管理、客户服务、可信交付和运营评价，推动分散资源形成来源明确、权利清晰、质量可控、可订购、可交付、可评价的数据产品、数据服务和场景服务。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "二、总体定位"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0052",
        "line_start": 116,
        "line_end": 116
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0063",
      "fact_type": "statement",
      "text": "三是建设多主体协同和价值共创载体。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "二、总体定位"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0053",
        "line_start": 118,
        "line_end": 118
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0064",
      "fact_type": "statement",
      "text": "组织需求单位、资源方、模型算法方、专业服务方、技术实施方和市场生态方，围绕行业共性需求和客户业务问题开展产品开发、场景共建和持续运营，形成资源共享、能力互补、责任清晰、收益合理的协同机制。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "二、总体定位"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0053",
        "line_start": 118,
        "line_end": 118
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0065",
      "fact_type": "statement",
      "text": "平台立足中电联行业引领和服务职能，构建服务国家、赋能行业、支撑中电联内部发展的多层次服务体系，为政府宏观能源决策、能源规划和行业治理提供数据分析支撑，为新型能源体系和新型电力系统建设提供行业数据底座，为电力企业生产经营、科技创新和数字化转型提供专业服务，为产业链上下游及跨行业主体协同创新创造基础条件。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "二、总体定位"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0054",
        "line_start": 120,
        "line_end": 120
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0066",
      "fact_type": "statement",
      "text": "中电联长期承担行业联系、统计分析、标准协调、专业研究、会员服务和政策沟通等职责，已形成组织制度、行业资源、既有平台、场景储备和实施推进等方面基础，具备开展首期产品开发、场景试点和生态合作的条件。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0055",
        "line_start": 124,
        "line_end": 124
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0067",
      "fact_type": "statement",
      "text": "一是组织制度基础。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0056",
        "line_start": 126,
        "line_end": 126
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0068",
      "fact_type": "statement",
      "text": "项目经国家能源主管部门研究并履行相关程序推荐，纳入国家数据基础设施建设先行先试范围。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0056",
        "line_start": 126,
        "line_end": 126
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0069",
      "fact_type": "statement",
      "text": "2025年9月，中电联启动电力领域数据基础设施建设先行先试项目并发布行业共建倡议；",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0056",
        "line_start": 126,
        "line_end": 126
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0070",
      "fact_type": "statement",
      "text": "2025年11月，中电联党委专题审议项目建设方案，成立项目领导小组、工作小组和工作专班，形成重大事项统筹、专业部门协同和运营单位实施机制。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0056",
        "line_start": 126,
        "line_end": 126
      },
      "segment_index": 4
    },
    {
      "fact_id": "fact-0071",
      "fact_type": "statement",
      "text": "二是行业资源基础。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0057",
        "line_start": 128,
        "line_end": 128
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0072",
      "fact_type": "statement",
      "text": "中电联拥有覆盖电力产业链主要环节的会员生态、专业分支机构和行业服务渠道，在政策标准、行业统计、设备可靠性、绿色低碳、科技成果、信用评价、人才教育和专业研究等方面形成长期积累，为资源组织、产品设计、场景论证和合作推广提供支撑。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0057",
        "line_start": 128,
        "line_end": 128
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0073",
      "fact_type": "statement",
      "text": "三是既有平台基础。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0058",
        "line_start": 130,
        "line_end": 130
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0074",
      "fact_type": "statement",
      "text": "电力公共信息平台及相关业务平台为资源接入、服务发布、用户服务和运营管理提供既有系统、数据接口和运行经验。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0058",
        "line_start": 130,
        "line_end": 130
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0075",
      "fact_type": "statement",
      "text": "项目将在既有系统基础上，按照建设任务逐步完善可信连接、统一目录、产品运营、安全管控和计量结算等共性能力。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0058",
        "line_start": 130,
        "line_end": 130
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0076",
      "fact_type": "statement",
      "text": "四是场景储备基础。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0059",
        "line_start": 132,
        "line_end": 132
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0077",
      "fact_type": "statement",
      "text": "中电联已围绕生产运行、绿色低碳、供需市场、科研教育、成果转化等领域形成一批可进一步论证的场景储备，行业机构、会员单位、科研院所、高等院校和专业服务机构具备参与首期产品开发和场景共建的基础条件。",
      "heading_path": [
        "第一章　建设背景与合作基础",
        "三、建设基础"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0059",
        "line_start": 132,
        "line_end": 132
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0078",
      "fact_type": "statement",
      "text": "五是实施推进基础。",
      "heading_path": [
        "第一章　建设背景与合作基础",
