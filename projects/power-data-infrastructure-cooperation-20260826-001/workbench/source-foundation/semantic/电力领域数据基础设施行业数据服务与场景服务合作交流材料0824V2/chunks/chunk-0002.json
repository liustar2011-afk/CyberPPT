      "fact_id": "fact-0110",
      "fact_type": "statement",
      "text": "四是资源与能力合作伙伴。",
      "heading_path": [
        "第二章　平台建设与运营体系",
        "二、参与主体与业务关系"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0073",
