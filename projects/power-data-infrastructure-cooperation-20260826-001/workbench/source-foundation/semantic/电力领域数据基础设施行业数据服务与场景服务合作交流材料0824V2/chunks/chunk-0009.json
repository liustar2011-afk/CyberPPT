    {
      "fact_id": "fact-0532",
      "fact_type": "statement",
      "text": "客户由合作伙伴、专业部门、分支机构或者其他渠道主体引入，并由其承担较多售前、商务和持续维护工作的，可以单独设置客户获取或者渠道贡献。",
      "heading_path": [
