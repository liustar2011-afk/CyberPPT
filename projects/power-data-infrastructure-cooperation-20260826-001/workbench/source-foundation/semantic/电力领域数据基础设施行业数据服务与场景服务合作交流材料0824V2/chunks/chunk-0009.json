  "facts": [
    {
      "fact_id": "fact-0481",
      "fact_type": "statement",
      "text": "八是能源行业核心数据。",
      "heading_path": [
        "附件六　数据分类分级与交付方式适配要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0267",
        "line_start": 618,
        "line_end": 618
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0482",
      "fact_type": "statement",
      "text": "落实高等级安全保护和严格的跨法人主体提供、转移、共享管理要求，相关合作履行必要评估和内部决策程序，未经确认不得纳入一般产品化服务。",
      "heading_path": [
        "附件六　数据分类分级与交付方式适配要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0267",
        "line_start": 618,
        "line_end": 618
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0483",
      "fact_type": "statement",
      "text": "九是模型和知识服务。",
      "heading_path": [
        "附件六　数据分类分级与交付方式适配要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0268",
        "line_start": 620,
        "line_end": 620
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0484",
      "fact_type": "statement",
      "text": "对模型权重、训练数据、专属知识库和提示词实施隔离和权限控制，明确输入输出日志、版本回退、内容安全、结果校核和客户专属信息保护。",
      "heading_path": [
        "附件六　数据分类分级与交付方式适配要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0268",
        "line_start": 620,
        "line_end": 620
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0485",
      "fact_type": "statement",
      "text": "十是服务周期和动态调整。",
      "heading_path": [
        "附件六　数据分类分级与交付方式适配要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0269",
        "line_start": 622,
        "line_end": 622
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0486",
      "fact_type": "statement",
      "text": "根据业务需要确定单次交付、周期更新或者持续运营安排；",
      "heading_path": [
        "附件六　数据分类分级与交付方式适配要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0269",
        "line_start": 622,
        "line_end": 622
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0487",
      "fact_type": "statement",
      "text": "数据内容、规模、精度、用途、客户范围或者安全环境发生变化时，重新评估分类分级、部署环境、处理方式和安全措施。",
      "heading_path": [
        "附件六　数据分类分级与交付方式适配要点"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0269",
        "line_start": 622,
        "line_end": 622
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0488",
      "fact_type": "statement",
      "text": "平台不设置统一对外价格、固定服务费率或者固定分成比例。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0270",
        "line_start": 626,
        "line_end": 626
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0489",
      "fact_type": "statement",
      "text": "单项产品和场景根据客户采购条件、产品成熟度、资源稀缺性、各方实际投入和风险责任独立开展经营测算，具体商务安排履行必要的内部审批和合作确认程序。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0270",
        "line_start": 626,
        "line_end": 626
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0490",
      "fact_type": "statement",
      "text": "一是客户报价基本公式。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0271",
        "line_start": 628,
        "line_end": 628
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0491",
      "fact_type": "statement",
      "text": "客户成交价可以按照“服务产品价格＋实施部署费用＋专属资源保障费用＋安全合规保障费用＋持续运营保障费用＋税费”组合形成。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0271",
        "line_start": 628,
        "line_end": 628
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0492",
      "fact_type": "statement",
      "text": "服务产品价格可以包含平台基础运营及支持、数据或者模型使用等内容；",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0271",
        "line_start": 628,
        "line_end": 628
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0493",
      "fact_type": "statement",
      "text": "标准产品根据实际选择适用费用项，复杂场景分别测算服务产品、实施部署和运营保障费用。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0271",
        "line_start": 628,
        "line_end": 628
      },
      "segment_index": 4
    },
    {
      "fact_id": "fact-0494",
      "fact_type": "statement",
      "text": "二是数据接口服务参考模型。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0272",
        "line_start": 630,
        "line_end": 630
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0495",
      "fact_type": "statement",
      "text": "客户价格可以由年度基础价格、套餐调用额度、超额调用价格、并发或者性能保障价格和专属支持费用构成。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0272",
        "line_start": 630,
        "line_end": 630
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0496",
      "fact_type": "statement",
      "text": "合作伙伴已经具有成熟接口和稳定服务能力的，可以采用供给方结算单价，平台取得与产品运营、技术交付和客户服务相对应的运营收入。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0272",
        "line_start": 630,
        "line_end": 630
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0497",
      "fact_type": "statement",
      "text": "三是数据集与知识服务参考模型。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0273",
        "line_start": 632,
        "line_end": 632
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0498",
      "fact_type": "statement",
      "text": "客户价格可以由版本授权价格、年度更新价格、使用主体或者账户费用、专属加工费用和安全交付费用构成。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0273",
        "line_start": 632,
        "line_end": 632
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0499",
      "fact_type": "statement",
      "text": "报价应区分内部研究、业务系统应用、模型训练和对外服务等用途，并根据授权期限、主体范围、数据规模、更新频率和再使用条件设置差异化价格。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0273",
        "line_start": 632,
        "line_end": 632
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0500",
      "fact_type": "statement",
      "text": "四是模型与智能服务参考模型。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0274",
        "line_start": 634,
        "line_end": 634
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0501",
      "fact_type": "statement",
      "text": "客户价格可以由模型或者知识服务授权价格、调用或者任务处理价格、专属实例费用、算力费用、模型适配或者微调费用和年度运维费用构成。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0274",
        "line_start": 634,
        "line_end": 634
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0502",
      "fact_type": "statement",
      "text": "涉及客户专属知识库、模型微调或者客户环境部署的，应当单独测算数据治理、训练评测、安全测试、升级维护和专属资源成本。",
