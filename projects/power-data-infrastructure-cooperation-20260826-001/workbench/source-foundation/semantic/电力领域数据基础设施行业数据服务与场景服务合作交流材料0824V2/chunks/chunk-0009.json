      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
      "semantic_role": "unclassified",
      "source_ref": {
        "block_id": "blk-0284",
        "line_start": 654,
        "line_end": 654
      },
      "segment_index": 1
    },
    {
      "fact_id": "fact-0535",
      "fact_type": "statement",
      "text": "标准产品应当形成目录价格、合作伙伴结算基准、最低成交价格或者最低毛利要求。",
      "heading_path": [
