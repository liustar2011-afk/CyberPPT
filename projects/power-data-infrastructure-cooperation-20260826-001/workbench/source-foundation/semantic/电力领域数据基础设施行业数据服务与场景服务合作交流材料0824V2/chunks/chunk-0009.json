        "line_end": 642
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0517",
      "fact_type": "statement",
      "text": "比例根据资源贡献、产品和模型开发、客户获取与市场拓展、平台运营与交付、持续服务和风险责任综合确定。",
      "heading_path": [
