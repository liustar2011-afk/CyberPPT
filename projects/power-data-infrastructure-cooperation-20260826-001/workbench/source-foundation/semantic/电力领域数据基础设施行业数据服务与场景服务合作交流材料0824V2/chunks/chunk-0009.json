        "line_start": 646,
        "line_end": 646
      },
      "segment_index": 2
    },
    {
      "fact_id": "fact-0523",
      "fact_type": "statement",
      "text": "贡献评分用于确定比例，不单独替代固定价格、收入比例或者里程碑等结算基础。",
