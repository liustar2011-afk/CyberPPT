        "line_end": 658
      },
      "segment_index": 3
    },
    {
      "fact_id": "fact-0543",
      "fact_type": "statement",
      "text": "同一主体承担多项责任的合并计算，最终以实际协议和履约评价为准。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
