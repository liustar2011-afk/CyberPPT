    },
    {
      "fact_id": "fact-0542",
      "fact_type": "statement",
      "text": "各方可以按照资源与核心能力、产品与模型开发、客户与市场、平台运营与交付、持续服务与风险责任等贡献维度协商确定比例。",
      "heading_path": [
        "附件七　商务报价与收益分配参考模型"
      ],
      "claim_status": "source_assertion",
      "verification_status": "unverified",
