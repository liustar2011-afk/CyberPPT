{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ppt-visual-structure-designer/visual-medium-policy.schema.json",
  "title": "CyberPPT Stage2 Visual Medium Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preferred",
    "allowed",
    "scene_policy",
    "rationale"
  ],
  "properties": {
    "preferred": {
      "enum": [
        "business_scene",
        "object_illustration",
        "relationship_diagram",
        "data_visualization",
        "mixed"
      ]
    },
    "allowed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "business_scene",
          "object_illustration",
          "relationship_diagram",
          "data_visualization",
          "mixed"
        ]
      }
    },
    "scene_policy": {
      "enum": [
        "required",
        "allowed",
        "forbidden",
        "auto"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
