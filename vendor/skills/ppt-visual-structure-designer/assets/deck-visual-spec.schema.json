{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ppt-visual-structure-designer/deck-visual-spec.schema.json",
  "title": "PPT Deck Visual Structure Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deck_id",
    "deck_title",
    "deck_context",
    "global_profile",
    "content_lock",
    "pages",
    "deck_rhythm",
    "capacity_suggestions",
    "qa_summary"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "deck_rhythm": {
            "required": [
              "color_roles"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "properties": {
          "deck_rhythm": {
            "properties": {
              "color_roles": false
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "deck_id": {
      "type": "string",
      "minLength": 1
    },
    "deck_title": {
      "type": "string",
      "minLength": 1
    },
    "deck_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "purpose",
        "usage_scene",
        "narrative",
        "source_files"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "usage_scene": {
          "type": "string",
          "minLength": 1
        },
        "narrative": {
          "type": "string",
          "minLength": 5
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "global_profile": {
      "type": "string",
      "minLength": 1
    },
    "content_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "global_locked_terms",
        "global_forbidden_changes"
      ],
      "properties": {
        "default_mode": {
          "enum": [
            "strict",
            "semantic",
            "open"
          ]
        },
        "global_locked_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "global_forbidden_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "page-visual-spec.schema.json"
      }
    },
    "deck_rhythm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "density_pattern",
        "visual_intent_sequence",
        "repetition_control"
      ],
      "properties": {
        "density_pattern": {
          "type": "string",
          "minLength": 1
        },
        "visual_intent_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repetition_control": {
          "type": "string",
          "minLength": 1
        },
        "color_roles": {
          "type": "string",
          "minLength": 1,
          "deprecated": true
        }
      }
    },
    "capacity_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qa_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "average_score",
        "blocking_issues",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "passed",
            "failed"
          ]
        },
        "average_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "blocking_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
