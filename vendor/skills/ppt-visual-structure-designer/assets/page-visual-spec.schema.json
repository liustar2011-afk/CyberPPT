{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ppt-visual-structure-designer/page-visual-spec.schema.json",
  "title": "PPT Page Visual Structure Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "page_id",
    "page_number",
    "page_title",
    "page_role",
    "page_mission",
    "core_judgment",
    "content_lock",
    "evidence_units",
    "semantic_graph",
    "visual_decision",
    "text_integration",
    "geometry",
    "image_plan",
    "connectors",
    "final_text",
    "generation_handoff",
    "avoid",
    "qa"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "page_id": {
      "type": "string",
      "pattern": "^P[0-9]{2,3}$"
    },
    "page_number": {
      "type": "integer",
      "minimum": 1
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "page_role": {
      "type": "string",
      "minLength": 1
    },
    "page_mission": {
      "type": "string",
      "minLength": 8
    },
    "core_judgment": {
      "type": "string",
      "minLength": 6
    },
    "content_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "locked_items",
        "allowed_transformations",
        "forbidden_transformations"
      ],
      "properties": {
        "mode": {
          "enum": [
            "strict",
            "semantic",
            "open"
          ]
        },
        "locked_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "text",
              "source_ref"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allowed_transformations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_transformations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "kind",
          "priority",
          "source_ref",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "fact",
              "judgment",
              "actor",
              "capability",
              "process",
              "result",
              "constraint",
              "metric"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "semantic_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_relation",
        "direction",
        "nodes",
        "edges",
        "decision_relationship"
      ],
      "properties": {
        "primary_relation": {
          "enum": [
            "support",
            "flow",
            "transform",
            "converge",
            "diverge",
            "layer",
            "cause",
            "compare",
            "loop",
            "control",
            "exchange",
            "boundary",
            "evidence",
            "responsibility",
            "none"
          ]
        },
        "direction": {
          "enum": [
            "left_to_right",
            "right_to_left",
            "top_to_bottom",
            "bottom_to_top",
            "outside_to_center",
            "center_to_outside",
            "closed_loop",
            "spatial",
            "none"
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "relation",
              "label"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "relation": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "decision_relationship": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "visual_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_intent_type",
        "visual_thesis",
        "dominant_visual_carrier",
        "spatial_organization",
        "reading_path",
        "text_integration_method",
        "relationship_encoding",
        "visual_center_count",
        "visual_hierarchy"
      ],
      "properties": {
        "visual_intent_type": {
          "type": "string",
          "minLength": 1
        },
        "visual_thesis": {
          "type": "string",
          "minLength": 8
        },
        "dominant_visual_carrier": {
          "type": "string",
          "minLength": 6
        },
        "spatial_organization": {
          "type": "string",
          "minLength": 8
        },
        "reading_path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "text_integration_method": {
          "type": "string",
          "minLength": 5
        },
        "relationship_encoding": {
          "type": "string",
          "minLength": 5
        },
        "visual_center_count": {
          "const": 1
        },
        "visual_hierarchy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "secondary",
            "tertiary"
          ],
          "properties": {
            "primary": {
              "type": "string",
              "minLength": 1
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tertiary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "text_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_render_mode",
        "subtitle_render_mode",
        "body_render_mode",
        "font_family",
        "minimum_font_pt",
        "placement_strategy"
      ],
      "properties": {
        "title_render_mode": {
          "enum": [
            "external_text_layer",
            "in_image"
          ]
        },
        "subtitle_render_mode": {
          "enum": [
            "external_text_layer",
            "in_image",
            "none"
          ]
        },
        "body_render_mode": {
          "enum": [
            "in_image",
            "external_text_layer",
            "mixed"
          ]
        },
        "font_family": {
          "type": "string",
          "minLength": 1
        },
        "minimum_font_pt": {
          "type": "number",
          "minimum": 12
        },
        "placement_strategy": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "title_exclusion_zone",
        "regions"
      ],
      "properties": {
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "ratio"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "ratio": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "title_exclusion_zone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "w": {
              "type": "number",
              "minimum": 0
            },
            "h": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role",
              "x",
              "y",
              "w",
              "h",
              "priority"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "priority": {
                "enum": [
                  "primary",
                  "secondary",
                  "tertiary"
                ]
              }
            }
          }
        }
      }
    },
    "image_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_scene",
        "scene_type",
        "business_object",
        "semantic_role",
        "placement",
        "front_facing_people",
        "identifiable_location",
        "factual_event_implication"
      ],
      "properties": {
        "use_scene": {
          "type": "boolean"
        },
        "scene_type": {
          "type": "string"
        },
        "business_object": {
          "type": "string"
        },
        "semantic_role": {
          "type": "string"
        },
        "placement": {
          "type": "string"
        },
        "front_facing_people": {
          "const": false
        },
        "identifiable_location": {
          "const": false
        },
        "factual_event_implication": {
          "const": false
        }
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type",
          "direction",
          "label",
          "main_chain"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "main_chain": {
            "type": "boolean"
          }
        }
      }
    },
    "final_text": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "text",
          "region_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "region_id": {
            "type": "string"
          }
        }
      }
    },
    "generation_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_guidance",
        "required_text",
        "style_guidance",
        "negative_constraints",
        "title_exclusion_instruction"
      ],
      "properties": {
        "composition_guidance": {
          "type": "string",
          "minLength": 20
        },
        "required_text": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "style_guidance": {
          "type": "string",
          "minLength": 10
        },
        "negative_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "title_exclusion_instruction": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "avoid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "score",
        "blocking_issues",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "passed",
            "failed"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "blocking_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
