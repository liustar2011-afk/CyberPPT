{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticAudit",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "source_fidelity_score", "coverage_score", "page_purity_score", "visual_alignment_score", "overall_comment"],
      "properties": {
        "pass": {"type": "boolean"},
        "source_fidelity_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "coverage_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "page_purity_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "visual_alignment_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "overall_comment": {"type": "string"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "page_id", "asset_id", "description", "recommendation"],
        "properties": {
          "severity": {"type": "string", "enum": ["error", "warning", "info"]},
          "code": {"type": "string"},
          "page_id": {"type": "string"},
          "asset_id": {"type": "string"},
          "description": {"type": "string"},
          "recommendation": {"type": "string"}
        }
      }
    }
  }
}
