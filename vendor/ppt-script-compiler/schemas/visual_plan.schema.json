{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["global_visual_rules", "pages"],
  "properties": {
    "global_visual_rules": {"type": "array", "items": {"type": "string"}},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_id", "visual_intent_type", "visual_thesis", "dominant_carrier", "scene_anchor", "composition", "reading_path", "emphasis_primary", "emphasis_secondary", "text_embedding", "imagery", "layout_regions", "avoid", "aspect_ratio", "title_rendering", "generation_prompt"],
        "properties": {
          "page_id": {"type": "string", "pattern": "^P[0-9]{2,3}$"},
          "visual_intent_type": {"type": "string"},
          "visual_thesis": {"type": "string"},
          "dominant_carrier": {"type": "string"},
          "scene_anchor": {"type": "string"},
          "composition": {"type": "string"},
          "reading_path": {"type": "array", "items": {"type": "string"}},
          "emphasis_primary": {"type": "string"},
          "emphasis_secondary": {"type": "array", "items": {"type": "string"}},
          "text_embedding": {"type": "array", "items": {"type": "string"}},
          "imagery": {"type": "array", "items": {"type": "string"}},
          "layout_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["region_id", "purpose", "content_ref", "position", "relative_size", "z_order"],
              "properties": {
                "region_id": {"type": "string"},
                "purpose": {"type": "string"},
                "content_ref": {"type": "string"},
                "position": {"type": "string"},
                "relative_size": {"type": "string", "enum": ["small", "medium", "large", "dominant"]},
                "z_order": {"type": "integer", "minimum": 0, "maximum": 20}
              }
            }
          },
          "avoid": {"type": "array", "items": {"type": "string"}},
          "aspect_ratio": {"type": "string"},
          "title_rendering": {"type": "string", "enum": ["ppt_text_layer", "in_image"]},
          "generation_prompt": {"type": "string"}
        }
      }
    }
  }
}
