{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreenCopy",
  "type": "object",
  "additionalProperties": false,
  "required": ["pages"],
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_id", "title", "subtitle", "conclusion", "modules", "annotations", "source_asset_ids", "content_lock"],
        "properties": {
          "page_id": {"type": "string", "pattern": "^P[0-9]{2,3}$"},
          "title": {"type": "string"},
          "subtitle": {"type": "string"},
          "conclusion": {"type": "string"},
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["module_id", "heading", "body_lines", "asset_ids"],
              "properties": {
                "module_id": {"type": "string", "pattern": "^M[0-9]{2,3}$"},
                "heading": {"type": "string"},
                "body_lines": {"type": "array", "items": {"type": "string"}},
                "asset_ids": {"type": "array", "items": {"type": "string", "pattern": "^A[0-9]{3,5}$"}}
              }
            }
          },
          "annotations": {"type": "array", "items": {"type": "string"}},
          "source_asset_ids": {"type": "array", "items": {"type": "string", "pattern": "^A[0-9]{3,5}$"}},
          "content_lock": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title_meaning", "core_judgment", "required_facts", "required_terms", "prohibited_rewrites", "prohibited_additions"],
            "properties": {
              "title_meaning": {"type": "string"},
              "core_judgment": {"type": "string"},
              "required_facts": {"type": "array", "items": {"type": "string"}},
              "required_terms": {"type": "array", "items": {"type": "string"}},
              "prohibited_rewrites": {"type": "array", "items": {"type": "string"}},
              "prohibited_additions": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
