{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberppt.local/contracts/final-script.schema.json",
  "title": "CyberPPT Final Script Contract",
  "type": "object",
  "required": [
    "contract",
    "version",
    "deck",
    "slides"
  ],
  "$defs": {
    "sourceProvenance": {
      "type": "object",
      "required": [
        "packet_sha256",
        "source_refs",
        "unit_ids"
      ],
      "properties": {
        "packet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "provenanceItem": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "provenanceBinding": {
      "type": "object",
      "required": [
        "target",
        "source_refs",
        "relation"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relation": {
          "type": "string",
          "enum": [
            "expresses",
            "supports",
            "qualifies",
            "implements",
            "contrasts",
            "sequences"
          ]
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "derivation",
        "claim_refs",
        "bindings"
      ],
      "properties": {
        "derivation": {
          "type": "string",
          "enum": [
            "direct",
            "synthesis",
            "relation"
          ]
        },
        "claim_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenanceBinding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "derivation": {
                "const": "direct"
              }
            },
            "required": [
              "derivation"
            ]
          },
          "then": {
            "properties": {
              "claim_refs": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "derivation": {
                "enum": [
                  "synthesis",
                  "relation"
                ]
              }
            },
            "required": [
              "derivation"
            ]
          },
          "then": {
            "properties": {
              "claim_refs": {
                "minItems": 2
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "onscreenModule": {
      "type": "object",
      "required": [
        "heading"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/provenanceItem"
              }
            ]
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": true
    },
    "onscreenModuleV11": {
      "allOf": [
        {
          "$ref": "#/$defs/onscreenModule"
        },
        {
          "type": "object",
          "required": [
            "id",
            "provenance"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/provenanceItem"
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "contract": {
      "const": "cyberppt.final-script"
    },
    "version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "deck": {
      "type": "object",
      "required": [
        "title",
        "communication_goal"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "communication_goal": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string"
        },
        "delivery_mode": {
          "type": "string",
          "enum": [
            "presented",
            "self_read"
          ],
          "default": "self_read"
        },
        "authoring_mode": {
          "type": "string",
          "enum": [
            "faithful",
            "analytical"
          ],
          "default": "faithful"
        },
        "narrative": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "page_type",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[Pp]?\\d+$"
          },
          "page_type": {
            "type": "string",
            "enum": [
              "cover",
              "contents",
              "chapter",
              "content",
              "closing"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string",
            "minLength": 1
          },
          "mission": {
            "type": "string"
          },
          "core_message": {
            "type": "string"
          },
          "argument": {
            "type": "object",
            "required": [
              "pattern",
              "chain"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "chain": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          },
          "full_copy": {
            "type": "string"
          },
          "onscreen": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/onscreenModule"
            }
          },
          "onscreen_expected_peer_count": {
            "type": "integer",
            "minimum": 1
          },
          "content_load": {
            "type": "string",
            "enum": [
              "light",
              "standard",
              "dense"
            ],
            "default": "standard"
          },
          "visual_thesis": {
            "type": "string"
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "relation"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "speaker_notes": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_provenance": {
            "$ref": "#/$defs/sourceProvenance"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "page_type": {
                  "const": "content"
                }
              },
              "required": [
                "page_type"
              ]
            },
            "then": {
              "required": [
                "full_copy",
                "onscreen",
                "source_refs",
                "source_provenance"
              ],
              "properties": {
                "full_copy": {
                  "minLength": 1
                },
                "onscreen": {
                  "minItems": 1
                },
                "source_refs": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "source_provenance"
                ]
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "required": [
                    "core_message"
                  ]
                },
                {
                  "required": [
                    "argument"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "core_message",
                "argument",
                "full_copy",
                "onscreen",
                "visual_thesis",
                "speaker_notes"
              ],
              "properties": {
                "core_message": {
                  "minLength": 1
                },
                "full_copy": {
                  "minLength": 1
                },
                "onscreen": {
                  "minItems": 1
                },
                "visual_thesis": {
                  "minLength": 1
                },
                "speaker_notes": {
                  "minLength": 1
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.1"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "slides": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "page_type": {
                        "const": "content"
                      }
                    },
                    "required": [
                      "page_type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "onscreen": {
                        "items": {
                          "$ref": "#/$defs/onscreenModuleV11"
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}