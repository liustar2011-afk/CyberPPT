{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberppt.local/contracts/final-script.schema.json",
  "title": "CyberPPT Final Script Contract",
  "type": "object",
  "required": [
    "contract",
    "version",
    "deck",
    "slides"
  ],
  "properties": {
    "contract": {
      "const": "cyberppt.final-script"
    },
    "version": {
      "const": "1.0"
    },
    "deck": {
      "type": "object",
      "required": [
        "title",
        "communication_goal"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "communication_goal": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string"
        },
        "delivery_mode": {
          "type": "string",
          "enum": [
            "presented",
            "self_read"
          ],
          "default": "self_read"
        },
        "narrative": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "page_type",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[Pp]?\\d+$"
          },
          "page_type": {
            "type": "string",
            "enum": [
              "cover",
              "contents",
              "chapter",
              "content",
              "closing"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string",
            "minLength": 1
          },
          "mission": {
            "type": "string"
          },
          "core_message": {
            "type": "string"
          },
          "argument": {
            "type": "object",
            "required": [
              "pattern",
              "chain"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "chain": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          },
          "full_copy": {
            "type": "string"
          },
          "onscreen": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "heading"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "onscreen_expected_peer_count": {
            "type": "integer",
            "minimum": 1
          },
          "content_load": {
            "type": "string",
            "enum": [
              "light",
              "standard",
              "dense"
            ],
            "default": "standard"
          },
          "visual_thesis": {
            "type": "string"
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "relation"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "speaker_notes": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "page_type": {
                  "const": "content"
                }
              },
              "required": [
                "page_type"
              ]
            },
            "then": {
              "required": [
                "mission",
                "core_message",
                "argument",
                "full_copy",
                "onscreen",
                "visual_thesis",
                "speaker_notes"
              ],
              "properties": {
                "mission": {
                  "minLength": 1
                },
                "core_message": {
                  "minLength": 1
                },
                "full_copy": {
                  "minLength": 1
                },
                "onscreen": {
                  "minItems": 1
                },
                "visual_thesis": {
                  "minLength": 1
                },
                "speaker_notes": {
                  "minLength": 1
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
