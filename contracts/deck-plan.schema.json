{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberppt.local/contracts/deck-plan.schema.json",
  "title": "CyberPPT Deck Plan",
  "type": "object",
  "required": ["communication_goal", "chapters", "pages"],
  "$defs": {
    "relation_basis": {"type": "string", "enum": ["explicit", "inferred"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "structural_operation": {"type": "string", "enum": ["preserve", "split", "merge_within_chapter", "user_authorized_cross_chapter"]}
  },
  "properties": {
    "communication_goal": {"type": "string"},
    "audience": {"type": "string"},
    "audience_scope": {"type": "string", "enum": ["internal", "external", "mixed", "unspecified"]},
    "source_structure_mode": {"type": "string", "enum": ["preserve", "user_authorized_restructure"]},
    "narrative_arc": {"type": "string"},
    "thesis": {"type": "string"},
    "audience_start": {"type": "string"},
    "audience_end": {"type": "string"},
    "storyline": {"type": "array", "items": {"type": "string"}},
    "content_load_curve": {"type": "string"},
    "chapters": {"type": "array", "items": {"type": "object", "required": ["id", "purpose"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "purpose": {"type": "string"}, "question": {"type": "string"}, "message": {"type": "string"}, "relationship_to_previous": {"type": "string"}, "source_chapter_ids": {"type": "array", "items": {"type": "string"}}, "source_scope": {"type": "array", "items": {"type": "string"}}, "structural_operation": {"$ref": "#/$defs/structural_operation"}}, "additionalProperties": true}},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "question", "message", "logic", "content"], "properties": {"id": {"type": "string"}, "chapter_id": {"type": "string"}, "title": {"type": "string"}, "question": {"type": "string"}, "message": {"type": "string"}, "logic": {"type": "string"}, "content": {"type": "array", "items": {"type": "string"}}, "next": {"type": "string"}, "source_refs": {"type": "array", "items": {"type": "string"}}, "source_scope": {"type": "array", "items": {"type": "string"}}, "structural_operation": {"$ref": "#/$defs/structural_operation"}, "page_role": {"type": "string"}, "content_load": {"type": "string", "enum": ["light", "standard", "dense"]}, "receives": {"type": "string"}, "must_include": {"type": "array", "items": {"type": "string"}}, "reserved_for_later": {"type": "array", "items": {"type": "string"}}, "analysis_basis": {"type": "object", "properties": {"model": {"type": "string"}, "relation_basis": {"$ref": "#/$defs/relation_basis"}, "confidence": {"$ref": "#/$defs/confidence"}, "supports": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}}, "additionalProperties": true}, "proof": {"type": "object", "properties": {"method": {"type": "string"}, "claims": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "boundary_refs": {"type": "array", "items": {"type": "string"}}, "relation_basis": {"$ref": "#/$defs/relation_basis"}}, "additionalProperties": true}, "visibility_decision": {"type": "string", "enum": ["external_ok", "internal_only_used_as_hidden_support", "user_approved_exposure", "not_applicable"]}}, "additionalProperties": true}}
  },
  "additionalProperties": true
}
