{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberppt.local/contracts/deck-plan.schema.json",
  "title": "CyberPPT Deck Plan v2 Lean",
  "type": "object",
  "required": [
    "communication_goal",
    "plan_contract_version",
    "planning_profile",
    "source_structure_mode",
    "chapters",
    "pages"
  ],
  "properties": {
    "communication_goal": {"type": "string", "minLength": 1},
    "plan_contract_version": {"const": 2},
    "planning_profile": {"const": "lean"},
    "authoring_mode": {
      "type": "string",
      "enum": ["faithful", "analytical"],
      "default": "faithful",
      "description": "faithful is the default source-faithful pagination mode; analytical requires explicit user intent."
    },
    "audience": {"type": "string"},
    "audience_scope": {
      "type": "string",
      "enum": ["internal", "external", "mixed", "unspecified"]
    },
    "source_structure_mode": {
      "type": "string",
      "enum": ["preserve", "presentation_grouping", "user_authorized_restructure"]
    },
    "presentation_structure_mode": {
      "type": "string",
      "enum": ["formal_chaptered", "continuous"]
    },
    "chapter_count_exception": {"type": "string", "minLength": 1},
    "chapters": {
      "type": "array",
      "items": {"$ref": "#/$defs/chapter"}
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "structural_operation": {
      "type": "string",
      "enum": [
        "preserve",
        "merge_adjacent",
        "group_adjacent_source_chapters",
        "split_for_presentation",
        "user_authorized_cross_chapter"
      ]
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title", "purpose", "source_chapter_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "source_chapter_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "structural_operation": {"$ref": "#/$defs/structural_operation"}
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["id", "title", "question", "logic", "page_role", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "chapter_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "logic": {
          "type": "string",
          "minLength": 1,
          "description": "PLAN-time page mission; AUTHOR owns the final proposition and prose."
        },
        "page_role": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
