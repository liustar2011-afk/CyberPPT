{
  "version": "1.1",
  "default_profile": "default",
  "blocking_kinds": [
    "schema",
    "structural",
    "delivery_cleanliness",
    "delivery_policy",
    "safety"
  ],
  "warning_kinds": [
    "semantic_heuristic",
    "style_heuristic"
  ],
  "forbidden_default_kinds": [
    "project_specific"
  ],
  "sources": [
    {
      "id": "final-script-schema",
      "path": "contracts/final-script.schema.json",
      "profile": "default",
      "kind": "schema",
      "severity": "blocking",
      "owner": "script_engine.schema_contracts"
    },
    {
      "id": "module-semantic-contract",
      "path": "script_engine/semantic_contract",
      "profile": "default",
      "kind": "structural",
      "severity": "blocking",
      "owner": "script_engine.semantic_contract"
    },
    {
      "id": "banned-phrasing",
      "path": "contracts/banned-phrasing.json",
      "profile": "default",
      "kind": "mixed",
      "severity": "mixed",
      "owner": "script_engine.lint_contracts"
    },
    {
      "id": "legacy-script-quality",
      "path": "cyberppt/script_quality/rules.yaml",
      "profile": "legacy",
      "kind": "semantic_heuristic",
      "severity": "warning",
      "owner": "cyberppt.script_quality",
      "default_enabled": false
    }
  ],
  "deterministic_findings": [
    {
      "code": "AUTHOR_MISSION_GENERIC",
      "kind": "semantic_heuristic",
      "severity": "warning",
      "scope": "author_supporting_fields",
      "confidence": "medium",
      "owner": "script_engine.author_contracts",
      "severity_rationale": "Generic mission wording is an editorial review signal; wording alone cannot prove source-boundary failure."
    },
    {
      "code": "AUTHOR_VISUAL_THESIS_NONRELATIONAL",
      "kind": "semantic_heuristic",
      "severity": "warning",
      "scope": "author_supporting_fields",
      "confidence": "medium",
      "owner": "script_engine.author_contracts",
      "severity_rationale": "Visible relation grammar cannot be proven solely from lexical relation markers."
    },
    {
      "code": "AUTHOR_VISUAL_TOPOLOGY_CONFLICT",
      "kind": "semantic_heuristic",
      "severity": "warning",
      "scope": "author_supporting_fields",
      "confidence": "medium",
      "owner": "script_engine.author_contracts",
      "severity_rationale": "Topology wording is a review candidate unless a structured semantic relation establishes the conflict."
    },
    {
      "code": "AUTHOR_VISUAL_THESIS_RESTATEMENT",
      "kind": "semantic_heuristic",
      "severity": "warning",
      "scope": "author_supporting_fields",
      "confidence": "medium",
      "owner": "script_engine.author_contracts",
      "severity_rationale": "String similarity can flag possible restatement but cannot prove semantic duplication."
