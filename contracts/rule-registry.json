      "severity": "warning",
      "scope": "author_relationships",
      "confidence": "medium",
      "owner": "script_engine.author_contracts",
      "severity_rationale": "A lexical transition marker cannot deterministically prove an omitted business node."
    },
    {
      "code": "AUTHOR_RELATION_ABSTRACT_TRANSFORMATION",
      "kind": "semantic_heuristic",
      "severity": "warning",
      "scope": "author_relationships",
      "confidence": "medium",
      "owner": "script_engine.author_contracts",
      "severity_rationale": "Generic transformation verbs are insufficient to prove an unsupported semantic relation."
    },
    {
